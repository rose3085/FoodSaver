<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="FoodSaverMaui.Views.CreateAccount"
              xmlns:viewmodel="clr-namespace:FoodSaverMaui.ViewModel"
             x:DataType="viewmodel:CreateAccountViewModel"
             NavigationPage.HasNavigationBar="False"
             >

    <ContentPage.Content >


       
            <Grid  >

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <StackLayout Grid.Row="0" Padding="20" VerticalOptions="End"
                         HorizontalOptions="FillAndExpand">
                    <Label Text="Create an Account"
                       FontSize="Title" TextColor="#385897"
                       FontFamily="PoppinsBold"
                       HorizontalOptions="Center"></Label>

                </StackLayout>


            <ScrollView Grid.Row="1" >
                    <StackLayout Padding="10" Spacing="10" >
                        
                        
                        <Frame BackgroundColor="#f7f7f7" BorderColor="Black" Padding="0" 
                               Margin="30,0,30,0">
                            <Grid  ColumnSpacing="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Source="user.png" WidthRequest="34" HeightRequest="34"
                               Margin="10,0,0,0"
                               HorizontalOptions="Start"
                               VerticalOptions="Center" Grid.Column="0" />
                                <Entry Placeholder="Username"  
                                       Text="{Binding UserName}"
                                       PlaceholderColor="Black"
                           FontSize="Medium"
                               Grid.Column="1" HorizontalOptions="Start"
                           WidthRequest="{OnIdiom Phone=250, Tablet=400}" />

                            </Grid>
                        </Frame>


                    <Frame BackgroundColor="#f7f7f7" BorderColor="Black" Padding="0" 
                               Margin="30,10,30,0">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Source="email.png" WidthRequest="34" HeightRequest="34"
            Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" Grid.Column="0" />
                            <Entry Placeholder="Email"
                                   Text="{Binding Email}"
                                   PlaceholderColor="Black"
                               FontSize="Medium"
                                   Grid.Column="1" HorizontalOptions="Start"
                               WidthRequest="{OnIdiom Phone=250, Tablet=400}" />
                        </Grid>
                    </Frame>


                    <Frame BackgroundColor="#f7f7f7" BorderColor="Black" Padding="0" 
           Margin="30,10,30,0">

                        <Grid  ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Source="phone.png" WidthRequest="34" HeightRequest="34"
Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" Grid.Column="0" />
                            <Entry Placeholder="Phone" 
                                   Text="{Binding Phone}"
                                   PlaceholderColor="Black"
                           FontSize="Medium" Grid.Column="1" HorizontalOptions="Start"
                            WidthRequest="{OnIdiom Phone=250, Tablet=400}" />
                        </Grid>
                    </Frame>


                    <Frame BackgroundColor="#f7f7f7" BorderColor="Black" Padding="0" 
           Margin="30,10,30,0">


                        <Grid  ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Source="key.png" WidthRequest="34" HeightRequest="34"
Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" Grid.Column="0" />
                            <Entry Placeholder="Password" 
                                   Text="{Binding Password}"
                                   PlaceholderColor="Black" IsPassword="True"
                           FontSize="Medium" Grid.Column="1" HorizontalOptions="Start"
                             WidthRequest="{OnIdiom Phone=250, Tablet=400}" />
                        </Grid>
                    </Frame>


                    <Frame BackgroundColor="#f7f7f7" BorderColor="Black" Padding="0" 
           Margin="30,10,30,0">

                        <Grid  ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Source="key.png" WidthRequest="34" HeightRequest="34"
Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" Grid.Column="0" />
                            <Entry Placeholder="ConfirmPassword" Text="{Binding ConfirmPassword}"  PlaceholderColor="Black" IsPassword="True"
                           FontSize="Medium" Grid.Column="1" HorizontalOptions="Start"
                            WidthRequest="{OnIdiom Phone=250, Tablet=400}" />
                        </Grid>
                    </Frame>
                    <StackLayout RadioButtonGroup.GroupName="role" Margin="0,0,0,0">
                        <Frame BackgroundColor="#f7f7f7" BorderColor="Black" Padding="5" HorizontalOptions="Start" 
                         Margin="30,10,30,0">

                            <Grid  ColumnSpacing="25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Source="down.png" WidthRequest="34" HeightRequest="34"
                        Margin="0,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" Grid.Column="0" />
                                <Label Text="Choose a Role" FontSize="Medium"
                                       HorizontalOptions="Center" Grid.Column="1"
                                        Margin="10,0,0,0"
                        WidthRequest="{OnIdiom Phone=261, Tablet=400}" >
                                    
                                </Label>
                            </Grid>
                            <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRadioButtonsCommand}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                        
                        <RadioButton Content="Buyer"
                                     GroupName="RoleGroup" 
                                     IsChecked="{Binding IsBuyerChecked}" 
                                     IsVisible="{Binding IsRadioButtonsVisible}" HorizontalOptions="Center"/>
                        <RadioButton Content="Seller"
                                     GroupName="RoleGroup" 
                 IsChecked="{Binding IsSellerChecked}" 
                                     
                                     IsVisible="{Binding IsRadioButtonsVisible}" HorizontalOptions="Center"/>

                        </StackLayout>
                        <Button Text="Sign Up" BackgroundColor="#03b25a" Margin="0,10,0,0"
                            WidthRequest="{OnIdiom Phone=320, Tablet=400}" 
                            HorizontalOptions="Center" 
                                Command="{Binding OnRegisterTapped}"
                                />

                    <Frame HeightRequest="75" 
       BackgroundColor="Transparent" 
       BorderColor="Transparent"
        Margin="0,-10,0,0">

                        <StackLayout x:Name="LoadingOverlay"
             Margin="0,-10,0,0"
             BackgroundColor="Transparent"
             Opacity="0.7"
            
             VerticalOptions="Center"
             HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="White" />

                        </StackLayout>
                    </Frame>
                    
                </StackLayout>
              
            </ScrollView>
            <StackLayout Grid.Row="3" Orientation="Horizontal" Padding="15"
                         HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Spacing="15">
                <Label Text="Already have an account?"
   FontSize="Micro" VerticalOptions="Center"
   HorizontalOptions="Center" />
                <Label Text="Sign In"   FontSize="Small"
 HorizontalOptions="Center" TextColor="#385897">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnSignInTapped}" />
                    </Label.GestureRecognizers>
                    
                    
                </Label>
            </StackLayout>
        </Grid>
        
    </ContentPage.Content>
</ContentPage>