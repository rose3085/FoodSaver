<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodSaverMaui.Views.UploadFood"
               xmlns:viewmodel="clr-namespace:FoodSaverMaui.ViewModel"
              xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            x:DataType="viewmodel:UploadFoodViewModel"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             Title="Upload Food"
             >

  
   
    
        <Grid
         RowDefinitions="Auto,Auto,Auto,Auto,*"  HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"
            >
            <Grid Margin="15,20,0,0" HorizontalOptions="Center" VerticalOptions="Center">
            <Frame
            BorderColor="Gray"
            BackgroundColor="WhiteSmoke"
            Padding="10"
            HeightRequest="200"
            WidthRequest="330"
            HorizontalOptions="Center"
            VerticalOptions="Center">

                <ImageButton 
           
                    Source="{Binding PickedImage}"
                    Command="{Binding OnFliePicked}" 
                    Aspect="AspectFill"
                   
                >
                   
                        <ImageButton.Triggers>
                            <DataTrigger TargetType="ImageButton" Binding="{Binding IsImageSelected}" Value="false">
                                <Setter Property="Source" Value="plus.png" />
                                <Setter Property="HeightRequest" Value="30"/>
                                <Setter Property="WidthRequest" Value="30 "/>



                            </DataTrigger>
                            <DataTrigger TargetType="ImageButton" Binding="{Binding IsImageSelected}" Value="true">
                                <Setter Property="Source" Value="{Binding PickedImage}" />
                                <Setter Property="BackgroundColor" Value="Transparent" />
                               <Setter Property="HeightRequest" Value="180"/>
                                <Setter Property="WidthRequest" Value="310 "/>
                            </DataTrigger>
                        </ImageButton.Triggers>
                   
                    </ImageButton>
                </Frame>
            </Grid>

            <Grid RowDefinitions="Auto,*" Grid.Row="1"  HorizontalOptions="Start" VerticalOptions="Start" Padding="30,10,0,20">

            <Grid Grid.Row="0" ColumnSpacing="10" ColumnDefinitions="Auto,Auto" >
                <BoxView Grid.ColumnSpan="0"
                HeightRequest="10"
                WidthRequest="10"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Color="#03b25a"
                                BackgroundColor="Transparent"
                CornerRadius="25" >     
                    <BoxView.Shadow>
                        <Shadow  Brush="Green"
             Offset="0,10"
            Opacity="0.3" />
                    </BoxView.Shadow>
                </BoxView>
                <Label Grid.Column="1" Text="Title"
                       FontSize="18" FontAttributes="Bold" TextColor="#385897"/>
            </Grid>
            <Entry Grid.Row="1" Text="{Binding Food}" Placeholder="Enter Food Name" WidthRequest='330' />

            </Grid>
            <Grid RowDefinitions="Auto,*" Grid.Row="2" HorizontalOptions="Start" VerticalOptions="Start" Padding="30,10,0,20">
            <Grid Grid.Row="0" ColumnSpacing="10" ColumnDefinitions="Auto,Auto" >
                <BoxView Grid.ColumnSpan="0"
            HeightRequest="10"
            WidthRequest="10"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Color="#03b25a"
                            BackgroundColor="Transparent"
            CornerRadius="25" > 
                    <BoxView.Shadow>
                        <Shadow  Brush="Green"
             Offset="0,10"
            Opacity="0.3" />
                    </BoxView.Shadow>
                </BoxView>
                <Label Grid.Column="1" Text="Description" FontSize="18" FontAttributes="Bold" TextColor="#385897"/>
            </Grid>
            <Editor 
            Grid.Row="1"
            Placeholder="Enter description here..."
            AutoSize="TextChanges"
            MaxLength="250"  
                Text="{Binding Description}"    
            HeightRequest="130"
                   
                    WidthRequest="330"
            BackgroundColor="WhiteSmoke"
                   
                    Margin="0,10,0,0"/>

            </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto" ColumnSpacing="25" >
            <Grid RowDefinitions="Auto,*" Grid.Column="0"  HorizontalOptions="Start" VerticalOptions="Start" Padding="30,10,0,20">
                <Grid Grid.Row="0" ColumnSpacing="5" ColumnDefinitions="Auto,Auto" >
                    <BoxView Grid.ColumnSpan="0"
                HeightRequest="10"
                WidthRequest="10"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Color="#03b25a"
                                BackgroundColor="Transparent"
                CornerRadius="25" > 
                        <BoxView.Shadow>
                            <Shadow  Brush="Green"
                 Offset="0,10"
                Opacity="0.3" />
                        </BoxView.Shadow>
                    </BoxView>
                    <Label Grid.Column="1" Text="Price/Kg" FontSize="18" FontAttributes="Bold" TextColor="#385897"/>
                </Grid>
                <Entry Grid.Row="1" Text="{Binding Price}" Placeholder="Enter price" WidthRequest='150' />

            </Grid>
            <Grid RowDefinitions="Auto,*" RowSpacing="15" Grid.Column="1"  HorizontalOptions="Start" VerticalOptions="Start" Padding="30,10,0,20">
                <Grid Grid.Row="0" ColumnSpacing="5" ColumnDefinitions="Auto,Auto" >
                    <BoxView Grid.ColumnSpan="0"
                HeightRequest="10"
                WidthRequest="10"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Color="#03b25a"
                                BackgroundColor="Transparent"
                CornerRadius="25" >     
                        <BoxView.Shadow>
                            <Shadow  Brush="Green"
                 Offset="0,10"
                Opacity="0.3" />
                        </BoxView.Shadow>
                    </BoxView>
                    
                    <Label Grid.Column="1" Text="Quantity" FontSize="18" FontAttributes="Bold" TextColor="#385897"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="30" Grid.Row="1"  HorizontalOptions="Start" VerticalOptions="Start" >
                    <ImageButton Grid.Column="0"
            Source="minus.png"
            WidthRequest="10"
            HeightRequest="10"
            Command="{Binding DecrementCommand}" />
                    <Label Grid.Column="1" Text="{Binding StepperValue}" FontSize="18" FontAttributes="Bold" TextColor="#385897"/>

                    <ImageButton  Grid.Column="2"
          Source="plus.png"
            WidthRequest="10"
            HeightRequest="10"
            Command="{Binding IncrementCommand}" />
                </Grid>


            </Grid>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="15" ColumnDefinitions="*,Auto"  Padding="30,30,10,0">
            <Button Text="Confirm" BackgroundColor="#03b25a" Grid.Column="0"  HorizontalOptions="Center"
    WidthRequest="330" Command="{Binding OnPostTapped}"

   
     />

        </Grid>
    </Grid>

   




</ContentPage>