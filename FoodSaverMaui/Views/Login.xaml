<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodSaverMaui.Views.Login"
              xmlns:viewmodel="clr-namespace:FoodSaverMaui.ViewModel"
            x:DataType="viewmodel:LoginViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             NavigationPage.HasNavigationBar="False"
             x:Name="LoginPage"
            >

    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Green" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

        <Grid Grid.Row="0" RowDefinitions="Auto" Padding="50,80,100,0" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">

            <Label Grid.Row="0" Text="Login to your account!"
           FontSize="30" TextColor="#385897"
           FontFamily="PoppinsBold"
           HorizontalOptions="Center"></Label>  
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="20" >

            <Frame BackgroundColor="#f7f7f7" BorderColor="Black" Padding="0"  Grid.Row="0"
                Margin="30,10,30,0">


                <Grid ColumnSpacing="15" Padding="3" ColumnDefinitions="Auto,*" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" >


                    <Image  Source="email.png" WidthRequest="34" HeightRequest="34"
            Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" Grid.Column="0" />
                    <Entry Placeholder="Email" x:Name="Email"
                           toolkit:SetFocusOnEntryCompletedBehavior.NextElement="{x:Reference Password}" ReturnType="Next"
                                   Text="{Binding Email}"
                                   PlaceholderColor="Black"
                               FontSize="Medium"
                                   Grid.Column="1" HorizontalOptions="Start"
                               WidthRequest="{OnIdiom Phone=220, Tablet=400}" >
                        <Entry.Behaviors>
                            <toolkit:EmailValidationBehavior 
                InvalidStyle="{StaticResource InvalidEntryStyle}"
                ValidStyle="{StaticResource ValidEntryStyle}"
                Flags="ValidateOnValueChanged" />
                        </Entry.Behaviors>
                    </Entry>
                </Grid>
            </Frame>

            <Frame BackgroundColor="#f7f7f7" BorderColor="Black" Padding="0"  Grid.Row="1"
           Margin="30,10,30,0">


                <Grid ColumnSpacing="15" Padding="3"  ColumnDefinitions="Auto,*" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" >
                    <Image Source="key.png" WidthRequest="34" HeightRequest="34"
                    Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center" Grid.Column="0" />
                    <Entry Placeholder="Password" x:Name="Password"
                                   Text="{Binding Password}"
                                   PlaceholderColor="Black" IsPassword="True"
                           FontSize="Medium" Grid.Column="1" HorizontalOptions="Start"
                             WidthRequest="{OnIdiom Phone=220, Tablet=400}" >
                        <Entry.Behaviors>
                            <toolkit:CharactersValidationBehavior 
                InvalidStyle="{StaticResource InvalidEntryStyle}"
                ValidStyle="{StaticResource ValidEntryStyle}"
                Flags="ValidateOnValueChanged"
                    RegexPattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*\W)[A-Za-z\d\W]{6,}$"
                CharacterType="Alphanumeric"
                MinimumCharacterTypeCount="6" />

                            <toolkit:UserStoppedTypingBehavior 
                        Command="{Binding Source={x:Reference LoginPage}, Path=BindingContext.SearchCommand}"
                        StoppedTypingTimeThreshold="10"
                        MinimumLengthThreshold="3"
                        ShouldDismissKeyboardAutomatically="True" />

                        </Entry.Behaviors>
                    </Entry>
                </Grid>
            </Frame>

            <Grid Grid.Row="2" ColumnSpacing="15" ColumnDefinitions="*,Auto"  Padding="30,20,10,0">
                <Button Text="Sign In" BackgroundColor="#03b25a" Grid.Column="0"  HorizontalOptions="Start"
                 WidthRequest="{OnIdiom Phone=240, Tablet=350}" 
                
                     Command="{Binding OnSignInTapped}"
                     />
                <Border HorizontalOptions="End" HeightRequest="42" Background="Transparent"
                 WidthRequest="45" StrokeShape="RoundRectangle 20,20,20,20" StrokeThickness="1" 
                 >

                    <Frame Background="Transparent" Grid.Column="1" >
                        <Image Source="fingerprint.png" HeightRequest="32" WidthRequest="32" >
                            
                            
                        </Image>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer  Command="{Binding OnFingerPrintTapped}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </Border>
            </Grid>
        </Grid>


        <Grid Grid.Row="2" RowDefinitions="*,Auto">
            <Grid Grid.Row="0" HorizontalOptions="CenterAndExpand" VerticalOptions="StartAndExpand">
                <Frame HeightRequest="75" 
                BackgroundColor="Transparent" 
                BorderColor="Transparent"
    >   

                    <ActivityIndicator IsRunning="True" Color="Black" />

               
                </Frame>

            </Grid>


            <Grid Grid.Row="1" ColumnSpacing="15" ColumnDefinitions="Auto,*" Padding="10" HorizontalOptions="CenterAndExpand" VerticalOptions="EndAndExpand">
                <Label Grid.Column="0" Text="Don't have an account?"
                  FontSize="Medium" VerticalOptions="Center"
                  />
                <Label Grid.Column="1" Text="Register"   FontSize="Medium"
                TextColor="#385897">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnRegisterTapped}" />
                    </Label.GestureRecognizers>


                </Label>
            </Grid>
        </Grid>




    </Grid>





